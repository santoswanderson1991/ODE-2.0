{
    "name": "spaceham/ode-framework",
    "description": "ODE Framework for WordPress Delivery",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "monolog/monolog": "^3.9",
        "symfony/dependency-injection": "^7.3",
        "symfony/event-dispatcher": "^7.3",
        "symfony/filesystem": "^7.3",
        "symfony/finder": "^7.3",
        "symfony/http-foundation": "^7.3",
        "psr/log": "^3.0",
        "doctrine/collections": "^2.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "friendsofphp/php-cs-fixer": "^3.80"
    },
    "autoload": {
        "psr-4": {
            "ODE\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "php-cs-fixer fix"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}